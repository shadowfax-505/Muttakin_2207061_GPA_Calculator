<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/25"
            fx:controller="com.example.Muttakin_2207061_GPA_Calculator.HelloController"
            stylesheets="@style.css">

    <!-- BorderPane inside AnchorPane -->
    <BorderPane AnchorPane.topAnchor="0"
                AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0">

        <!-- Center of BorderPane -->
        <center>
            <VBox alignment="CENTER" spacing="20.0"
                  prefWidth="350" prefHeight="300">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Welcome to GPA Calculator"/>

                <Label fx:id="welcomeText" />

                <Button text="Start GPA Calculator"
                        onAction="#onHelloButtonClick"/>
            </VBox>
        </center>

    </BorderPane>

</AnchorPane>
